{
  "name": "vida-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API backend for vida",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/seed.ts",
    "migrate:payments": "tsx src/migratePayments.ts",
    "migrate:payments:apply": "tsx src/migratePayments.ts --apply",
    "migrate:chat-previews": "tsx src/migrateChatPreviews.ts",
    "migrate:chat-previews:apply": "tsx src/migrateChatPreviews.ts --apply",
    "migrate:legacy-fields": "tsx src/migrateLegacyFields.ts",
    "migrate:legacy-fields:apply": "tsx src/migrateLegacyFields.ts --apply",
    "migrate:vendor-accounts": "tsx src/migrateVendorAccounts.ts",
    "migrate:vendor-accounts:apply": "tsx src/migrateVendorAccounts.ts --apply",
    "test": "tsx --test src/domain/*.test.ts src/middleware/*.test.ts",
    "db:check": "tsx src/check-db.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.0",
    "mongoose": "^9.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
